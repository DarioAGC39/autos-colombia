# ==============================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO: .env.example
# Copia este archivo y renómbralo como ".env" (sin comillas) en la misma carpeta.
# IMPORTANTE: Nunca subas el archivo .env con contraseñas reales a GitHub o repositorios públicos.
# ==============================================================

# Clave secreta de Flask para sesiones y mensajes flash (puedes cambiarla por cualquier texto aleatorio)
SECRET_KEY=autos_colombia_clave_secreta_universitaria_2026

# Configuración de conexión a la Base de Datos MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña_aqui
MYSQL_DATABASE=autos_colombia
